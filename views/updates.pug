doctype html
html
  head
    title= title
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    .form-container
      a.add-link(href="/") < Return to the homepage
      h1 Add/Update Custom Object Record
      br
      form(action=id ? `/update-real-estate?id=${id}` : "/update-real-estate" method="POST")
        label Name:
        input(type="text", name="name", required value=(record ? record.properties.name : ""))

        label Price:
        input(type="number", name="price", required value=(record ? record.properties.price : ""))

        label Area (sq ft):
        input(type="number", name="area", required value=(record ? record.properties.price : ""))

        label Property Type:
        select(name="property_type", required)
            option(value="" disabled selected)= record ? "" : "Select Property Type"
            option(
            value="Apartment"
            selected=record && record.properties.property_type == "Apartment"
            ) Apartment
            option(
            value="Villa"
            selected=record && record.properties.property_type == "Villa"
            ) Villa
            option(
            value="Plot"
            selected=record && record.properties.property_type == "Plot"
            ) Plot
            option(
            value="Commercial"
            selected=record && record.properties.property_type == "Commercial"
            ) Commercial

        label Status:
        select(name="status" required)
            option(value="" disabled selected)= record ? "" : "Select Status"
            option(
            value="Available"
            selected=record && record.properties.status == "Available"
            ) Available
            option(
            value="Sold"
            selected=record && record.properties.status == "Sold"
            ) Sold
            option(
            value="Pending"
            selected=record && record.properties.status == "Pending"
            ) Pending

        button(type="submit")= id ? "Update Record" : "Create Record"